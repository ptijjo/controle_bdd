// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  controleur
  chef_service
  agent
}

enum FormProcessingStatus {
  pending
  processing
  completed
  failed
}

model User {
  id                  String         @id @default(cuid())
  email               String         @unique
  password            String
  nom                 String
  prenom              String
  role                Role           @default(agent)
  createdAt           DateTime       @default(now())
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  updatedAt           DateTime       @updatedAt

  LoginAttempts   LoginAttempts[]
  refreshTokens   RefreshToken[]
  formSubmissions FormSubmission[]
}

model LoginAttempts {
  id        String   @id @default(cuid())
  emailName String
  email     User     @relation(fields: [emailName], references: [email], onDelete: Cascade)
  success   Boolean
  ipAddress String
  createdAt DateTime @default(now())

  @@index([emailName])
  @@index([createdAt])
}

model IpBlock {
  id             String    @id @default(cuid())
  ipAddress      String    @unique
  failedAttempts Int       @default(0)
  blockedUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/** Jeton d’invitation consommé (inscription réussie via register/invite). */
model UsedInvitation {
  id        String   @id @default(cuid())
  jti       String   @unique
  email     String
  usedAt    DateTime @default(now())
  createdAt DateTime @default(now())
}

/** Refresh JWT actifs (révocation / rotation). */
model RefreshToken {
  id        String    @id @default(cuid())
  jti       String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/** Source de vérité des formulaires (Excel = dérivé / export). */
model FormSubmission {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload         Json
  ipAddress       String
  processingStatus FormProcessingStatus @default(pending)
  processingError String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([processingStatus])
}
